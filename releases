 	  shortPress(RunResetPin, 1);
        longPress(RunResetPin);
        shortPress(MenuPin, 7);    
        shortPress(MinusPin, 10);  
        shortPress(RunResetPin);
	  Delay 5 seconds;
        longPress(RunResetPin);


